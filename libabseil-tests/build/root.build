# Suppress warnings coming from external libraries (GoogleTest and Abseil
# headers). We only want to hear about the upstream tests themselves.
#
cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = h
cxx{*}: extension = cc

# Every exe{} in this package is a test and is not installed.
#
exe{*}: test = true
exe{*}: install = false
