intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# Abseil is built as a single library. Exclude upstream tests, benchmarks,
# mocks, code-generation tools, and the GoogleTest-based status matchers
# (all of which are testonly or not meant to be part of the library binary).
#
lib{abseil}: libul{abseil}: {hxx cxx}{**          \
  -**test**                                       \
  -**benchmark**                                  \
  -**mock**                                       \
  -**gentables**                                  \
  -**fuzz**                                       \
  -**status_matchers**                            \
  -**chi_square**                                 \
  -**print_hash_of}                               \
  $impl_libs $intf_libs

libs{abseil}: def{abseil}: include = ($cxx.target.system == 'win32-msvc')
def{abseil}: libul{abseil}

# Build options.
#
cxx.poptions =+ "-I$src_root"

# Stop <windows.h> from defining the min/max function-like macros (which
# break std::numeric_limits<>::max()/min() in the sources) and apply
# Abseil's standard define/warning configuration (matching upstream's
# ABSL_MSVC_FLAGS).
#
if ($cxx.target.class == 'windows')
{
  cxx.poptions += -DNOMINMAX -DWIN32_LEAN_AND_MEAN

  # MSVC-ABI CRT defines (also fine for clang targeting MSVC).
  #
  if ($cxx.target.system != 'mingw32')
    cxx.poptions += -D_CRT_SECURE_NO_WARNINGS -D_SCL_SECURE_NO_WARNINGS \
                    -D_ENABLE_EXTENDED_ALIGNED_STORAGE

  # MSVC command-line (cl/clang-cl) warning configuration. Guard on the
  # compiler class so we don't pass /-style options to a GCC-style driver
  # (e.g. clang++ targeting MSVC).
  #
  if ($cxx.class == 'msvc')
    cxx.coptions += /bigobj /wd4005 /wd4068 /wd4180 /wd4244 /wd4267 \
                    /wd4503 /wd4800

  # MinGW GCC ignores the MSVC-specific #pragma comment(lib) and #pragma
  # warning directives (we link the requested libraries ourselves, see
  # below). It also checks the ABSL_PRINTF_ATTRIBUTE functions against the
  # MSVCRT format and so rejects %zu even though libstdc++ selects the
  # MinGW ANSI stdio implementation that supports it.
  #
  if ($cxx.target.system == 'mingw32' && $cxx.id == 'gcc')
    cxx.coptions += -Wno-unknown-pragmas -Wno-format
}

# Build and consume the MSVC DLL the same way as upstream: export functions
# with the automatically generated .def file and data with ABSL_DLL, which
# is __declspec(dllexport) while building and __declspec(dllimport) while
# consuming. Note that ABSL_BUILD_DLL also disables ABSL_ATTRIBUTE_WEAK,
# without which Clang emits .weak.* helper symbols that link.exe refuses
# to export (LNK1242).
#
# Note also that the data symbols end up exported both with ABSL_DLL and
# by the .def file, which link.exe points out with the benign LNK4197.
#
if ($cxx.target.system == 'win32-msvc')
{
  objs{*}: cxx.poptions += -DABSL_BUILD_DLL
  libs{abseil}: cxx.loptions += /IGNORE:4197
}

# GCC reports a false-positive -Wmaybe-uninitialized for InlinedVector
# storage when inlining aggressively into cord.cc (upstream suppresses the
# same warning in other parts of inlined_vector.h).
#
if ($cxx.id == 'gcc')
  {obja objs}{strings/cord}: cxx.coptions += -Wno-maybe-uninitialized

# The hardware-accelerated AES random backend uses ISA intrinsics that GCC
# and Clang only make available with the corresponding target options (MSVC
# needs none). The backend is only selected if the CPU supports it at
# runtime, so these options are confined to this one translation unit, the
# same as upstream's ABSL_RANDOM_RANDEN_COPTS.
#
if ($cxx.class == 'gcc')
{
  switch $cxx.target.cpu
  {
    case 'x86_64'
      {obja objs}{random/internal/randen_hwaes}: \
        cxx.coptions += -maes -msse4.1

    case 'aarch64'
      {obja objs}{random/internal/randen_hwaes}: \
        cxx.coptions += -march=armv8-a+crypto
  }
}

# System libraries. Note that advapi32, which sysinfo.cc uses for the
# registry, is linked by default on Windows.
#
switch $cxx.target.class, $cxx.target.system
{
  case 'windows', 'mingw32'
    cxx.libs += -lbcrypt -ldbghelp

  case 'windows'
    cxx.libs += bcrypt.lib dbghelp.lib

  case 'macos'
  {
    # cctz's time_zone_lookup uses CoreFoundation to resolve the local time
    # zone on Apple platforms.
    #
    cxx.libs += -pthread -framework CoreFoundation
  }

  default
    cxx.libs += -pthread
}

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Export options.
#
lib{abseil}:
{
  cxx.export.poptions = "-I$src_root"
  cxx.export.libs = $intf_libs
}

if ($cxx.target.system == 'win32-msvc')
  libs{abseil}: cxx.export.poptions += -DABSL_CONSUME_DLL

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{abseil}: bin.lib.version = "-$version.project_id"
else
  lib{abseil}: bin.lib.version = "-$version.major.$version.minor"

# Some public headers textually include .inc files (e.g. numeric/int128.h).
#
lib{abseil}: inc{** -**test**}

# Install headers (and the .inc textual includes) into the absl/ subdirectory
# of, say, /usr/include/ recreating subdirectories.
#
{hxx inc}{*}:
{
  install         = include/absl/
  install.subdirs = true
}
