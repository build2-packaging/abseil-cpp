--- zone_info_source.cc.orig	2026-10-28 15:02:10.942107598 -0400
+++ zone_info_source.cc	2026-10-28 15:30:08.900120366 -0400
@@ -58,8 +58,13 @@
 // MinGW is GCC on Windows, so while it asserts __has_attribute(weak), the
 // Windows linker cannot handle that. Nor does the MinGW compiler know how to
 // pass "#pragma comment(linker, ...)" to the Windows linker.
+//
+// Clang targeting MSVC also asserts __has_attribute(weak) but emits a
+// .weak.* helper symbol for the weak definition, which the build2-generated
+// DLL .def file then exports and link.exe rejects (LNK1242). So use the
+// MSVC /alternatename approach below for it as well.
 #if (__has_attribute(weak) || defined(__GNUC__)) && !defined(__MINGW32__) && \
-    !defined(__CYGWIN__)
+    !defined(__CYGWIN__) && !defined(_MSC_VER)
 ZoneInfoSourceFactory zone_info_source_factory __attribute__((weak)) =
     DefaultFactory;
 #elif defined(_MSC_VER) && !defined(__MINGW32__) && !defined(_LIBCPP_VERSION)
